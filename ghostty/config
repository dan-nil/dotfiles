# Theme and appearance
theme = dark:TokyoNight Storm,light:TokyoNight Day
background-opacity = 1
background-blur = true

# macOS window chrome
macos-icon-frame = chrome
macos-titlebar-proxy-icon = visible
macos-titlebar-style = tabs

# Font
font-family = BlexMono Nerd Font
font-size = 17
font-thicken = true
font-thicken-strength = 96
# Cell and cursor sizing
adjust-cell-width = -1
adjust-cell-height = 2
adjust-cursor-thickness = 3

# Window behavior
window-inherit-working-directory = true
window-padding-balance = true

# Split visuals
split-divider-color = #33aadd

# Shell and cursor behavior
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true

# Keybindings: split creation
keybind = cmd+a>v=new_split:right
keybind = cmd+a>b=new_split:down
keybind = cmd+a>n=new_tab

# Keybindings: split navigation
keybind = cmd+a>k=goto_split:top
keybind = cmd+a>l=goto_split:right
keybind = cmd+a>j=goto_split:bottom
keybind = cmd+a>h=goto_split:left
keybind = cmd+a>x=close_surface

# Keybindings: split resizing
keybind = cmd+shift+k=resize_split:up,10
keybind = cmd+shift+j=resize_split:down,10
keybind = cmd+shift+h=resize_split:left,10
keybind = cmd+shift+l=resize_split:right,10

# Keybindings: global
keybind = global:cmd+ctrl+opt+shift+l=toggle_quick_terminal

# macOS option key
macos-option-as-alt = true

# Vim mode: entry
keybind = alt+v=activate_key_table:vim

# Vim mode: scrolling
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+g=scroll_to_bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up

# Vim mode: search
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next

# Vim mode: copy
keybind = vim/y=copy_to_clipboard

# Vim mode: exit
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table

# Vim mode: catch unbound keys
keybind = vim/catch_all=ignore

# Clipboard and safety
clipboard-paste-protection = false
